<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>a1b2c3d4-e5f6-7890-abcd-ef1234567890</Id>
  <Version>2.0.0</Version>
  <ProviderName>Unleashed IT / Gorelo</ProviderName>
  <DefaultLocale>en-GB</DefaultLocale>
  <DisplayName DefaultValue="Gorelo Ticket"/>
  <Description DefaultValue="Create Gorelo PSA tickets directly from emails — quick create and full task pane with client/contact auto-match."/>

  <IconUrl DefaultValue="REPLACE_WITH_YOUR_HOSTING_URL/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="REPLACE_WITH_YOUR_HOSTING_URL/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://github.com/unl3ash3dit/gorelo-ticket"/>

  <AppDomains>
    <AppDomain>api.usw.gorelo.io</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.3"/>
    </Sets>
  </Requirements>

  <!-- Legacy form factor (Outlook Classic 2016+) -->
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="REPLACE_WITH_YOUR_HOSTING_URL/src/taskpane/taskpane.html"/>
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <!-- Version overrides: ribbon buttons + modern task pane -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">

      <Requirements>
        <bt:Sets>
          <bt:Set Name="Mailbox" MinVersion="1.3"/>
        </bt:Sets>
      </Requirements>

      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="FunctionFile.Url"/>

            <!-- Message Read ribbon -->
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="gorelo.group">
                  <Label resid="GroupLabel"/>

                  <!-- Quick Create button (ExecuteFunction) -->
                  <Control xsi:type="Button" id="gorelo.quickCreate">
                    <Label resid="QuickCreateLabel"/>
                    <Supertip>
                      <Title resid="QuickCreateLabel"/>
                      <Description resid="QuickCreateTip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon16"/>
                      <bt:Image size="32" resid="Icon32"/>
                      <bt:Image size="80" resid="Icon80"/>
                    </Icon>
                    <Action xsi:type="ExecuteFunction">
                      <FunctionName>quickCreateTicket</FunctionName>
                    </Action>
                  </Control>

                  <!-- Create Ticket… button (ShowTaskpane) -->
                  <Control xsi:type="Button" id="gorelo.taskpane">
                    <Label resid="TaskpaneLabel"/>
                    <Supertip>
                      <Title resid="TaskpaneLabel"/>
                      <Description resid="TaskpaneTip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon16"/>
                      <bt:Image size="32" resid="Icon32"/>
                      <bt:Image size="80" resid="Icon80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                    </Action>
                  </Control>

                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>

      <Resources>
        <bt:Images>
          <bt:Image id="Icon16" DefaultValue="REPLACE_WITH_YOUR_HOSTING_URL/assets/icon-16.png"/>
          <bt:Image id="Icon32" DefaultValue="REPLACE_WITH_YOUR_HOSTING_URL/assets/icon-32.png"/>
          <bt:Image id="Icon80" DefaultValue="REPLACE_WITH_YOUR_HOSTING_URL/assets/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="FunctionFile.Url" DefaultValue="REPLACE_WITH_YOUR_HOSTING_URL/src/commands/commands.html"/>
          <bt:Url id="Taskpane.Url" DefaultValue="REPLACE_WITH_YOUR_HOSTING_URL/src/taskpane/taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="Gorelo"/>
          <bt:String id="QuickCreateLabel" DefaultValue="Quick Create"/>
          <bt:String id="TaskpaneLabel" DefaultValue="Create Ticket…"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="QuickCreateTip" DefaultValue="Create a Gorelo ticket from this email with one click using your saved defaults."/>
          <bt:String id="TaskpaneTip" DefaultValue="Open the Gorelo ticket form to set client, contact, priority and other options."/>
        </bt:LongStrings>
      </Resources>

    </VersionOverrides>
  </VersionOverrides>

</OfficeApp>
